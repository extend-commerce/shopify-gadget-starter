{
  "name": "shopify-gadget-starter",
  "version": "0.1.0",
  "description": "Internal package for Gadget app shopify-gadget-starter (Development environment)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "format:check": "prettier --check web/ api/ shared/ --ignore-unknown --no-error-on-unmatched-pattern",
    "format": "prettier --write web/ api/ shared/ --ignore-unknown --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "build": "NODE_ENV=production react-router build",
    "shopify": "shopify",
    "shopify:dev": "shopify app dev --no-update",
    "shopify:deploy": "shopify app deploy",
    "shopify:info": "shopify app info",
    "shopify:env": "shopify app env",
    "theme-extension": "yarn workspace theme-extension",
    "graphql-codegen": "graphql-codegen",
    "router-typegen": "react-router typegen",
    "commit": "cz",
    "prepare": "node .husky/install.mjs",
    "test": "vitest"
  },
  "resolutions": {
    "vite": "github:gadget-inc/vite#vite-v6.3.5-gitpkg-1f0e9a3d8"
  },
  "dependencies": {
    "@gadget-client/shopify-gadget-starter": "link:.gadget/client",
