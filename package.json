    "@gadgetinc/react-shopify-app-bridge": "^0.21.1",
    "@heymantle/client": "^1.1.63",
    "@heymantle/react": "^0.0.66",
    "@react-router/fs-routes": "^7.8.2",
    "@react-router/node": "^7.8.2",
    "@shopify/app-bridge-react": "^4.2.7",
    "date-fns": "^4.1.0",
    "fastify": "^4.24.2",
