    "jsonwebtoken": "^9.0.2",
    "mixpanel": "^0.18.1",
    "mixpanel-browser": "^2.70.0",
    "posthog-js": "^1.261.7",
    "posthog-node": "5.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.8.2",
    "shopify-api-node": "^3.15.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
