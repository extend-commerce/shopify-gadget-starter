{
  "extends": "./tsconfig.json",
  "exclude": [],
  "include": [
    "api/**/*",
    "global.d.ts",
    "reset.d.ts",
    "vite.config.mts",
    "vitest.config.mts",
    "eslint.config.ts",
    ".graphqlrc.ts",
    "settings.gadget.ts",
    "react-router.config.ts",
    "accessControl/permissions.gadget.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "noEmit": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "target": "es2020",
    "lib": ["es2020", "DOM"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "module": "node16",
    "types": ["@shopify/admin-api-client"]
  }
}
